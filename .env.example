# ============================================================
#  Copier ce fichier :  cp .env.example .env
#  Puis remplacer toutes les valeurs "change_me".
#  Le .env n'est JAMAIS commité (voir .gitignore) : il contient les secrets.
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=chess
POSTGRES_USER=chess
POSTGRES_PASSWORD=change_me

# --- Connexion du backend à la base ---
# "db" = nom du service dans docker-compose.yml (résolu par le DNS de Docker)
DB_HOST=db
DB_PORT=5432

# --- Backend ---
# Origines supplémentaires autorisées (séparées par des virgules).
# Inutile pour un usage normal : la page servie par Nginx est toujours acceptée,
# y compris depuis un autre PC (http://IP_DE_LA_MACHINE:8080).
CORS_ORIGIN=http://localhost:8080

# --- Frontend (seul port exposé sur la machine) ---
FRONTEND_PORT=8080
