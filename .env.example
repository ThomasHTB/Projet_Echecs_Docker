# ============================================================
#  Copier ce fichier :  cp .env.example .env
#  Puis remplacer toutes les valeurs "change_me".
#  Le fichier .env ne doit JAMAIS être commité.
#  Générer un secret :  openssl rand -hex 32
# ============================================================

# --- PostgreSQL : superuser (utilisé uniquement à l'initialisation) ---
POSTGRES_DB=chess
POSTGRES_USER=chess_admin
POSTGRES_PASSWORD=change_me_admin

# --- PostgreSQL : utilisateur applicatif (droits limités, utilisé par le backend) ---
APP_DB_USER=chess_app
APP_DB_PASSWORD=change_me_app
DB_HOST=db
DB_PORT=5432

# --- Backend ---
BACKEND_PORT=3000
JWT_SECRET=change_me_long_random_string
CORS_ORIGIN=http://localhost:8080

# --- Frontend (seul port exposé sur la machine) ---
FRONTEND_PORT=8080
