# ============================================================
#  Copier ce fichier :  cp .env.example .env
#  Puis remplacer toutes les valeurs "change_me".
#  Le fichier .env ne doit JAMAIS être commité.
#  Générer un secret :  openssl rand -hex 32
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=chess
POSTGRES_USER=chess
POSTGRES_PASSWORD=change_me

# --- Connexion du backend à la base ---
DB_HOST=db
DB_PORT=5432

# --- Backend ---
BACKEND_PORT=8000
JWT_SECRET=change_me_long_random_string
CORS_ORIGIN=http://localhost:8080

# --- Frontend (seul port exposé sur la machine) ---
FRONTEND_PORT=8080
